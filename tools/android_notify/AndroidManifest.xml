<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ranchsim.notify">

    <uses-sdk android:minSdkVersion="24" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Godot finds the plugin by this entry (Android plugin v2) -->
        <meta-data
            android:name="org.godotengine.plugin.v2.RanchNotify"
            android:value="org.ranchsim.notify.RanchNotify" />

        <receiver
            android:name="org.ranchsim.notify.AlarmReceiver"
            android:exported="false" />
    </application>

</manifest>
